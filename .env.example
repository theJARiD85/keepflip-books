# Server-only KeepFlip Books / Plaid configuration. Do not copy these into an
# EXPO_PUBLIC_* mobile environment and never expose PLAID_SECRET to the app.
APPWRITE_PLAID_CONNECTIONS_TABLE_ID=
APPWRITE_PLAID_TRANSACTIONS_TABLE_ID=

PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ANDROID_PACKAGE_NAME=com.keepflip.app
PLAID_WEB_REDIRECT_URI=https://your-web-app.example/KeepFlip-newUi/books
PLAID_TOKEN_ENCRYPTION_KEY=
PLAID_COUNTRY_CODES=US
PLAID_TRANSACTIONS_DAYS_REQUESTED=90

# Optional background webhook. The handler appends ?secret=... to the URL
# when creating Link tokens and accepts POST /plaid/webhook.
PLAID_WEBHOOK_URL=
PLAID_WEBHOOK_SECRET=
